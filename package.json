{
  "name": "peanutbot",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "PORT=19138 bun --watch src/index.ts",
    "server": "bun run build:assets && concurrently -k -n css,server -c cyan,magenta \\\"bun run watch:css\\\" \\\"bun --watch src/index.ts\\\"",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --watch",
    "build:fa": "node -e \"const fs=require('fs');fs.cpSync('node_modules/@fortawesome/fontawesome-free/css','public/fa/css',{recursive:true});fs.cpSync('node_modules/@fortawesome/fontawesome-free/webfonts','public/fa/webfonts',{recursive:true})\""
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/localtunnel": "^2.0.4",
    "eslint": "^9.31.0",
    "tailwindcss": "^3.4.19"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@orama/orama": "^3.1.18",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "discord.js": "^14.26.0",
    "express": "^5.2.1",
    "flexsearch": "^0.8.205",
    "localtunnel": "^2.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "revolt.js": "^7.2.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "stoat.js": "^7.3.6"
  }
}
